<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <TextView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="start|center_vertical"
        android:text="SHITBOX"
        android:textColor="@color/accent"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/offline_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:gravity="center"
        android:text="OFFLINE"
        android:textColor="@color/warn"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:maxLines="1"
        android:visibility="gone"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="120sp"
        android:autoSizeStepGranularity="1sp"/>

    <LinearLayout
        android:id="@+id/content_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/batt_value"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="start|bottom"
                android:text="—"
                android:textColor="@color/muted"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="120sp"
                android:autoSizeStepGranularity="1sp"/>
            <TextView
                android:id="@+id/batt_label"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="start|top"
                android:text="BATT"
                android:textColor="@color/muted"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/solar_value"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="start|bottom"
                android:text="—"
                android:textColor="@color/accent2"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="120sp"
                android:autoSizeStepGranularity="1sp"/>
            <TextView
                android:id="@+id/solar_label"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="start|top"
                android:text="SOLAR"
                android:textColor="@color/muted"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/signal_value"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="start|bottom"
                android:text="—"
                android:textColor="@color/accent3"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="80sp"
                android:autoSizeStepGranularity="1sp"/>
            <TextView
                android:id="@+id/signal_label"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="start|top"
                android:text="LTE"
                android:textColor="@color/muted"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
